---
/**
 * The 5 Norse-creature sections, in landing order (per LANDING_CONTENT.md):
 * Rata agent 🐿️ · Connectors 🦅 · Gatekeeper 🐺 · Primitives 🦌 · Runtime 🐉
 *
 * Each section's <slot> is left empty for now — the related service/provider
 * cards (Slack, GitHub, Snippet/Widget/…, etc.) will be added later.
 */
import ConceptSection from "./ConceptSection.astro";
import FeatureCard from "./FeatureCard.astro";
import memoryIcon from "../assets/icons/memory.svg?raw";
import durabilityIcon from "../assets/icons/durability.svg?raw";
import toolsIcon from "../assets/icons/tools.svg?raw";
import proactiveIcon from "../assets/icons/proactive.svg?raw";
import telegramIcon from "../assets/icons/telegram.svg?raw";
import whatsappIcon from "../assets/icons/whatsapp.svg?raw";
import slackIcon from "../assets/icons/slack.svg?raw";
import zaloIcon from "../assets/icons/zalo.svg?raw";
import workspaceIcon from "../assets/icons/workspace.svg?raw";
import socialIcon from "../assets/icons/social.svg?raw";
import integrationsIcon from "../assets/icons/integrations.svg?raw";
import yourownIcon from "../assets/icons/yourown.svg?raw";
import snippetIcon from "../assets/icons/snippet.svg?raw";
import widgetIcon from "../assets/icons/widget.svg?raw";
import gadgetIcon from "../assets/icons/gadget.svg?raw";
import workflowIcon from "../assets/icons/workflow.svg?raw";
import deployIcon from "../assets/icons/deploy.svg?raw";
import versioningIcon from "../assets/icons/versioning.svg?raw";
import scalingIcon from "../assets/icons/scaling.svg?raw";
import multimodelIcon from "../assets/icons/multimodel.svg?raw";
import squirrel from "../assets/animals/squirrel.svg?raw";
import eagle from "../assets/animals/eagle.svg?raw";
import wolf from "../assets/animals/wolf.svg?raw";
import deer from "../assets/animals/deer.svg?raw";
import dragon from "../assets/animals/dragon.svg?raw";
---

<ConceptSection
  icon={squirrel}
  kicker="Ratatoskr"
  title="Rata agent"
  tagline="Agent sống bên trong."
  {/* VI: Agent sống bên trong. Nhớ ngữ cảnh, học từ hành vi, sinh code và tự vận hành. */}
  desc="An agent that lives inside. It remembers context, learns from behavior, writes code, and runs on its own."
>
  {/* 4 agent-harness capabilities — Cloudflare Think standard */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={memoryIcon}
      title="Memory"
      desc="The agent's soul — it remembers facts and keeps long conversations intact, forgetting nothing."
    />
    <FeatureCard
      icon={durabilityIcon}
      title="Durability"
      desc="Retry-safe turns that resume where they dropped, and actions that pause and continue later."
    />
    <FeatureCard
      icon={toolsIcon}
      title="Tools & Actions"
      desc="Workspace, code, browser, and MCP tools — with approval gates and run-once safety."
    />
    <FeatureCard
      icon={proactiveIcon}
      title="Always-on"
      desc="Scheduled tasks and proactive turns let it act on its own — across web, chat, and voice."
      disabled
    />
  </div>
</ConceptSection>

<ConceptSection
  icon={deer}
  kicker="Four Stags"
  title="Primitives"
  tagline="Một prompt → 4 khối xây nên mọi thứ."
  {/* VI: Snippet · Widget · Gadget · Workflow — composable, ghép lại thành cả hệ thống. */}
  desc="Snippet · Widget · Gadget · Workflow — composable building blocks that combine into a whole system."
>
  {/* Four primitives — one card each */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={snippetIcon}
      title="Snippet"
      desc="A reusable block of logic with no UI — run it on demand or wire it into anything."
    />
    <FeatureCard
      icon={widgetIcon}
      title="Widget"
      desc="A small, glanceable UI you embed anywhere to surface live info at a glance."
    />
    <FeatureCard
      icon={gadgetIcon}
      title="Gadget"
      desc="A full mini web app — UI, agent, and data together — that acts on its own."
    />
    <FeatureCard
      icon={workflowIcon}
      title="Workflow"
      desc="Multi-step, durable execution that runs to completion and resumes on failure."
    />
  </div>
</ConceptSection>

<ConceptSection
  icon={eagle}
  kicker="Veðrfölnir"
  title="Connectors"
  tagline="Agent giao tiếp ra ngoài."
  {/* VI: Agent giao tiếp ra ngoài. Gửi/nhận tin qua kênh bạn dùng. */}
  desc="Your agent reaches the outside world — sending and receiving messages through the channels you already use."
>
  {/* Messaging channels — icons added later */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={telegramIcon}
      title="Telegram"
      desc="Chat with your agent and get replies right inside Telegram."
    />
    <FeatureCard
      icon={slackIcon}
      title="Slack"
      desc="Bring the agent into your workspace channels and DMs."
    />
    <FeatureCard
      icon={whatsappIcon}
      title="WhatsApp"
      desc="Reach your agent on the messenger your customers already use."
      disabled
    />
    <FeatureCard
      icon={zaloIcon}
      title="Zalo"
      desc="Connect with your agent over Zalo for local reach."
    />
  </div>
  <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-secondary">
    // and more
  </p>
</ConceptSection>

<ConceptSection
  icon={wolf}
  kicker="Fenrir"
  title="Gatekeepers"
  tagline="Agent truy cập công cụ của bạn."
  {/* VI: Agent truy cập công cụ của bạn — có kiểm soát, đúng quyền bạn cấp. */}
  desc="Your agent accesses your tools — controlled, and only with the permissions you grant."
>
  {/* Four access groups — one card each, icons added later */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={workspaceIcon}
      title="Identity & Workspace"
      desc="Sign in and work across Google, Microsoft, and Jira."
    />
    <FeatureCard
      icon={socialIcon}
      title="Social"
      desc="Reach LinkedIn, Facebook, TikTok, Instagram — and run Ads across them all."
    />
    <FeatureCard
      icon={integrationsIcon}
      title="Integrations"
      desc="Connect third-party tools like Supabase, Linear, and Notion."
    />
    <FeatureCard
      icon={yourownIcon}
      title="Your own"
      desc="Bring your own API, Data, and MCP servers."
    />
  </div>
  <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-secondary">
    // and more
  </p>
</ConceptSection>

<ConceptSection
  icon={dragon}
  kicker="Níðhöggr"
  title="Runtime and inferences"
  tagline="Ở gốc rễ — nơi mọi thứ thật sự CHẠY."
  {/* VI: Deploy, versioning, mở rộng theo yêu cầu, chạy inference đa mô hình, và nhiều thứ khác — tất cả đều trong Ratas Runtime. */}
  desc="Deploy, versioning, on-demand scaling, multi-model inference, and more — all inside the Ratas Runtime."
>
  {/* Runtime capabilities — four cards, icons added later */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={deployIcon}
      title="Deploy"
      desc="Whatever the agent builds goes live instantly — no servers for you to set up."
    />
    <FeatureCard
      icon={versioningIcon}
      title="Versioning"
      desc="Every change is versioned, so you can roll back or ship forward with confidence."
    />
    <FeatureCard
      icon={scalingIcon}
      title="Scaling"
      desc="Scales on demand from zero to peak, then back down — you never manage capacity."
    />
    <FeatureCard
      icon={multimodelIcon}
      title="Multi-model"
      desc="Run on Anthropic, OpenAI, Bedrock, or Cloudflare Workers AI — pick the right model per task."
    />
  </div>
</ConceptSection>
