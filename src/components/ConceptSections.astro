---
/**
 * The 5 Norse-creature sections, in landing order (per LANDING_CONTENT.md):
 * Rata agent 🐿️ · Connectors 🦅 · Gatekeeper 🐺 · Primitives 🦌 · Runtime 🐉
 *
 * Each section's <slot> is left empty for now — the related service/provider
 * cards (Slack, GitHub, Snippet/Widget/…, etc.) will be added later.
 */
import ConceptSection from "./ConceptSection.astro";
import FeatureCard from "./FeatureCard.astro";
import memoryIcon from "../assets/icons/memory.svg?raw";
import durabilityIcon from "../assets/icons/durability.svg?raw";
import toolsIcon from "../assets/icons/tools.svg?raw";
import proactiveIcon from "../assets/icons/proactive.svg?raw";
import telegramIcon from "../assets/icons/telegram.svg?raw";
import whatsappIcon from "../assets/icons/whatsapp.svg?raw";
import slackIcon from "../assets/icons/slack.svg?raw";
import zaloIcon from "../assets/icons/zalo.svg?raw";
import workspaceIcon from "../assets/icons/workspace.svg?raw";
import socialIcon from "../assets/icons/social.svg?raw";
import integrationsIcon from "../assets/icons/integrations.svg?raw";
import yourownIcon from "../assets/icons/yourown.svg?raw";
import snippetIcon from "../assets/icons/snippet.svg?raw";
import widgetIcon from "../assets/icons/widget.svg?raw";
import gadgetIcon from "../assets/icons/gadget.svg?raw";
import workflowIcon from "../assets/icons/workflow.svg?raw";
import deployIcon from "../assets/icons/deploy.svg?raw";
import versioningIcon from "../assets/icons/versioning.svg?raw";
import scalingIcon from "../assets/icons/scaling.svg?raw";
import multimodelIcon from "../assets/icons/multimodel.svg?raw";
import squirrel from "../assets/animals/squirrel.svg?raw";
import eagle from "../assets/animals/eagle.svg?raw";
import wolf from "../assets/animals/wolf.svg?raw";
import deer from "../assets/animals/deer.svg?raw";
import dragon from "../assets/animals/dragon.svg?raw";
import { getLocale } from "../i18n";
import { getStrings } from "../i18n/strings";

const locale = getLocale(Astro.url.pathname);
const t = getStrings(locale).sections;
---

<ConceptSection
  icon={squirrel}
  kicker="Ratatoskr"
  title="Rata agent"
  id="agents"
  desc={t.agent.desc}
>
  {/* 4 agent-harness capabilities — Cloudflare Think standard */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={memoryIcon}
      title={t.agent.cards.memory.title}
      desc={t.agent.cards.memory.desc}
    />
    <FeatureCard
      icon={durabilityIcon}
      title={t.agent.cards.durability.title}
      desc={t.agent.cards.durability.desc}
    />
    <FeatureCard
      icon={toolsIcon}
      title={t.agent.cards.tools.title}
      desc={t.agent.cards.tools.desc}
    />
    <FeatureCard
      icon={proactiveIcon}
      title={t.agent.cards.alwaysOn.title}
      desc={t.agent.cards.alwaysOn.desc}
    />
  </div>
</ConceptSection>

<ConceptSection
  icon={deer}
  kicker="Four Stags"
  title="Primitives"
  id="platform"
  desc={t.primitives.desc}
>
  {/* Four primitives — one card each */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={snippetIcon}
      title={t.primitives.cards.snippet.title}
      desc={t.primitives.cards.snippet.desc}
    />
    <FeatureCard
      icon={widgetIcon}
      title={t.primitives.cards.widget.title}
      desc={t.primitives.cards.widget.desc}
    />
    <FeatureCard
      icon={gadgetIcon}
      title={t.primitives.cards.gadget.title}
      desc={t.primitives.cards.gadget.desc}
    />
    <FeatureCard
      icon={workflowIcon}
      title={t.primitives.cards.workflow.title}
      desc={t.primitives.cards.workflow.desc}
    />
  </div>
</ConceptSection>

<ConceptSection
  icon={eagle}
  kicker="Veðrfölnir"
  title="Connectors"
  desc={t.connectors.desc}
>
  {/* Messaging channels — icons added later */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={telegramIcon}
      title={t.connectors.cards.telegram.title}
      desc={t.connectors.cards.telegram.desc}
    />
    <FeatureCard
      icon={slackIcon}
      title={t.connectors.cards.slack.title}
      desc={t.connectors.cards.slack.desc}
    />
    <FeatureCard
      icon={whatsappIcon}
      title={t.connectors.cards.whatsapp.title}
      desc={t.connectors.cards.whatsapp.desc}
      disabled
    />
    <FeatureCard
      icon={zaloIcon}
      title={t.connectors.cards.zalo.title}
      desc={t.connectors.cards.zalo.desc}
    />
  </div>
  <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-secondary">
    // and more
  </p>
</ConceptSection>

<ConceptSection
  icon={wolf}
  kicker="Fenrir"
  title="Gatekeepers"
  desc={t.gatekeepers.desc}
>
  {/* Four access groups — one card each, icons added later */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      disabled
      icon={workspaceIcon}
      title={t.gatekeepers.cards.workspace.title}
      desc={t.gatekeepers.cards.workspace.desc}
    />
    <FeatureCard
      icon={socialIcon}
      title={t.gatekeepers.cards.social.title}
      desc={t.gatekeepers.cards.social.desc}
    />
    <FeatureCard
      icon={integrationsIcon}
      title={t.gatekeepers.cards.integrations.title}
      desc={t.gatekeepers.cards.integrations.desc}
    />
    <FeatureCard
      icon={yourownIcon}
      title={t.gatekeepers.cards.yourOwn.title}
      desc={t.gatekeepers.cards.yourOwn.desc}
    />
  </div>
  <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-secondary">
    // and more
  </p>
</ConceptSection>

<ConceptSection
  icon={dragon}
  kicker="Níðhöggr"
  title="Runtime and inferences"
  desc={t.runtime.desc}
>
  {/* Runtime capabilities — four cards, icons added later */}
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 items-stretch">
    <FeatureCard
      icon={deployIcon}
      title={t.runtime.cards.deploy.title}
      desc={t.runtime.cards.deploy.desc}
    />
    <FeatureCard
      icon={versioningIcon}
      title={t.runtime.cards.versioning.title}
      desc={t.runtime.cards.versioning.desc}
    />
    <FeatureCard
      icon={scalingIcon}
      title={t.runtime.cards.scaling.title}
      desc={t.runtime.cards.scaling.desc}
    />
    <FeatureCard
      icon={multimodelIcon}
      title={t.runtime.cards.multimodel.title}
      desc={t.runtime.cards.multimodel.desc}
    />
  </div>
</ConceptSection>
