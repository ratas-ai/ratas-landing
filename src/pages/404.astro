---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Not found" lang="en">
  <main class="relative z-10 max-w-5xl mx-auto px-6 sm:px-8 min-h-[60vh] flex flex-col items-center justify-center text-center gap-4">
    <p class="font-mono text-brand text-sm uppercase tracking-wider">[404]</p>
    <h1 class="font-sans font-bold text-4xl text-primary">Page not found</h1>
    <p class="text-secondary">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="mt-2 font-sans text-[11px] uppercase tracking-wider text-brand hover:underline no-underline"
    >
      &gt; back_home
    </a>
  </main>
</Layout>
