---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ratas — agentic AI platform",
  description = "One prompt, a whole ecosystem. The agent lives inside.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer>
      <p>🐿️ Powered by Cloudflare</p>
    </footer>
  </body>
</html>
