{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratas-landing",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client"
  }
  // Hiện mọi trang static → chỉ serve assets, chưa có Worker.
  // Khi thêm route cần server (export const prerender = false), Astro sinh dist/_worker.js/index.js
  // → thêm: "main": "./dist/_worker.js/index.js"  (Cloudflare serve asset trước, fallback Worker).
  // Custom domain ratas.ai gắn ở Dashboard > Domains & Routes.
}
